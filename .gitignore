.DS_Store
._*
Thumbs.db
Desktop.ini

# R history and session files
.Rhistory
.Rapp.history
.RData
.RDataTmp
.Ruserdata

# Local configuration and generated analysis inputs
/root_dir.rds
/bugs_data.rds
/bugs_data_DD.rds

